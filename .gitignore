# Dependencies
node_modules/
.pnpm-store/

# Build output
.next/
dist/
build/
out/

# Turborepo
.turbo/

# Environment
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
playwright-report/
test-results/
.nyc_output/

# IDE / OS
.DS_Store
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Payload — payload-types.ts é versionado em packages/types/src
# para servir como contrato fim-a-fim entre cms e web.
media/
uploads/

# TypeScript
*.tsbuildinfo

# Sentry
.sentryclirc

# Artefatos transitórios de captura visual
.tmp-screenshots/

# apps/web/public/img/ é versionado (assets servidos em produção). Material-fonte
# bruto (fotos/logos em alta resolução, kit de marca) vive em arquivos-fonte/ na
# raiz, também versionado (26/08/2026) — não confundir os dois.
!apps/web/public/img/

# Assets binários do seed — vivem no Supabase Storage após
# pnpm payload:seed:imagens-home; o repo guarda só a estrutura e o
# manifesto de cada arquivo (alt, prefix, contexto). Mantemos um
# .gitkeep e o README do seed na pasta para indicar o caminho.
apps/cms/src/seed/assets/*
!apps/cms/src/seed/assets/.gitkeep
!apps/cms/src/seed/assets/README.md
# Exceção: instantâneo JSON do conteúdo editorial dos 15 programas
# (gerado por `pnpm programas:instantaneo`) é um snapshot revisável,
# não um binário efêmero de seed — fica versionado.
!apps/cms/src/seed/assets/programas.json
# Brainstorming visual companion (superpowers)
.superpowers/

# Worktrees locais de feature isolada (superpowers:using-git-worktrees)
.worktrees/
